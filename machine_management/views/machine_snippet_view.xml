<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   <template id="category_template_highlight" name="Machine List">
       <section class="categories_section">
           <div class="container">
               <div class="alert alert-info">
                   <h4>Top 4 Machines List snippet will be displayed here...
                       Please save to view the snippet
                   </h4>
                   <div id="#top_products_carousel"/>
               </div>
           </div>
       </section>
   </template>


    <template id="machine_list_snippet" inherit_id="website.snippets" name="Machine list Snippet">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t t-snippet="machine_management.category_template_highlight"/> </xpath>
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="machine_management.category_template_highlight"/>
        </xpath>
    </template>
</odoo>