<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<template id="machine_snippet_template" name="machine Snippet">
            <section class="s_basic_snippet">
                <div class="container py-4">
                    <div class="row">
                        <div class="col-12 text-center">
                             <h2>Machine List</h2>
                            <p>
                                Machine list snippet
                                You can use it to display fixed content on your website.
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        </template>

    <template id="machine_list_snippet" inherit_id="website.snippets" name="Machine list Snippet">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t t-snippet="machine_management.machine_snippet_template"
              t-thumbnail="/dynamic_snippet/static/src/images.jpeg"/> </xpath>
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="machine_management.machine_snippet_template"/>
        </xpath>
    </template>
</odoo>