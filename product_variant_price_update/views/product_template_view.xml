<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <data>
        <record id="product_template_inherit_view" model="ir.ui.view">
            <field name="name">product.template.inherit.view</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet[@name='product_form']//button[@name='action_open_documents']" position="after">
                     <div class="oe_button_box" name="button_box">
                          <button class="oe_stat_button" type="object"
                            name="action_open_wizard"
                            icon="fa-list">
                              <div class="o_stat_info">
                            <span class="o_stat_text">Update</span>
                              </div>
                        </button>
                     </div>
                </xpath>

                <xpath expr="//notebook" position="inside">
                    <page name="variants" string="Product Variants">
                        <group>
                            <field name="product_ids"/>
                        </group>
                    </page>

                </xpath>
            </field>
        </record>
 </data>
</odoo>