<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="machine_tree_views">
        <field name="name">product.template.wizard.tree</field>
        <field name="model">product.template.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="product_id"/>
           <field name="product_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="price"/>
                                    <field name="updated_price"/>

                                </list>

                                </field>
                 <footer>
                    <button name="action_update_price"
                            string="Update"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
            </field>
    </record>


    <record id="action_product_template_wizard" model="ir.actions.act_window">
        <field name="name">product.template.wizard</field>
        <field name="res_model">product.template.wizard</field>
        <field name="view_mode">list</field>
        <field name="target">new</field>
    </record>
</odoo>
