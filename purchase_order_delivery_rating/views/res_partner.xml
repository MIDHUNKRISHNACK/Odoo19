<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <data>
        <record id="res_partner_inherit_view" model="ir.ui.view">
            <field name="name">res.partner.inherit.view</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                 <xpath expr="//div[@name='button_box']" position="inside">
                     <div class="oe_button_box" name="button_box">
                          <button class="oe_stat_button" type="object"
                            name="action_open_purchase_order_list_view"
                            icon="fa-credit-card" >
                              <div class="o_stat_info">
                                  <span class="o_stat_text">Purchase Orders</span>
                              </div>
                        </button>
                    </div>

                </xpath>

                 <xpath expr="//field[@name='category_id']" position="after">
                    <field name="vendor_rating"/>
                 </xpath>

                <xpath expr="//notebook" position="inside">
                     <page string="Related Purchase Order " name="Purchase Order">
                                <list editable="bottom">
                                    <field name="purchase_order_ids"/>
                                </list>

                     </page>
                </xpath>

        </field>
</record>
 </data>
</odoo>