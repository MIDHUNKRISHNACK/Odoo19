<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <data>
        <record id="product_template_inherit_view" model="ir.ui.view">
            <field name="name">product.template.inherit.view</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page name="rating" string="Product Rating">
                        <group>
                            <field name="product_rating" class="h3 pe-2" widget="priority_switch"/>
                        </group>
                    </page>

                </xpath>
            </field>
        </record>
 </data>
</odoo>