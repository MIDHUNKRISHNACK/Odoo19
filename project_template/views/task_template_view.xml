<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--   tree view-->
         <record model="ir.ui.view" id="task_template_tree_views">
            <field name="name">task.template.tree</field>
            <field name="model">task.template</field>
            <field name="arch" type="xml">
                <list>
                    <field name="project_template_id"/>
                    <field name="name"/>
                    <field name="priority"/>
                    <field name="stage_id"/>
                    <field name="create_date"/>
                    <field name="allocated_hours"/>

                </list>
            </field>
        </record>


    <record model="ir.ui.view" id="task_template_forms_views">
        <field name="name">task_template_form</field>
        <field name="model">task.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                      <button name="button_task_create" type="object" string="Create Task" class="oe_highlight" />

                </header>
                <sheet>
                 <widget name="web_ribbon" text="Template" bg_color="text-bg-danger" invisible="not is_ribbon_template"/>
                    <group>

               <group>
                <field name="name"/>
                <field name="create_date"/>
                   <field name="date_end"/>
                   <field name="date_assign"/>
                <field name="date_deadline"/>

                </group>
                    <group>
                <field name="priority" class="h3 pe-2" widget="priority_switch"/>
                <field name="stage_id"/>
                   <field name="tag_ids" widget="many2many_tags"/>
                   <field name="project_template_id"/>
                <field name="allocated_hours"/>

                </group>
                    </group>
                <group>
                        <notebook>
                            <page string="Related Sub Tasks" name="subtasks">
                                <field name="child_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="project_template_id"/>
                                    <field name="create_date"/>
                                    <field name="allocated_hours"/>
                                    <field name="tag_ids"/>
                                </list>
                                </field>

                            </page>
                            <page string="Description" name="description">
                                <group>
                                <field name="description"/>
                                </group>
                            </page>
                        </notebook>
                </group>
                </sheet>
            </form>
        </field>
    </record>



    <record id="action_open_task_template" model="ir.actions.act_window">
        <field name="name">task_template</field>
        <field name="res_model">task.template</field>
        <field name="view_mode">kanban,form,list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create Your Task</p>
        </field>
    </record>

</odoo>