<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <data>
        <record id="project_project_inherit_view" model="ir.ui.view">
            <field name="name">project.project.inherit.view</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
               <xpath expr="//header" position="inside">
                <header>
                    <button name="button_project_template_create" type="object" string="Create Template" class="oe_highlight" />
                </header>
                 </xpath>
            </field>
        </record>
 </data>
</odoo>