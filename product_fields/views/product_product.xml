<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <data>
        <record id="product_product_inherit_view" model="ir.ui.view">
            <field name="name">product.product.inherit.view</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='barcode']" position="after">
                            <field name="product_master_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="product_brand_id" invisible="product_master_type == 'single'"/>
                </xpath>
            </field>
        </record>

     <record id="product_product_inherit_tree_view" model="ir.ui.view">
            <field name="name">product.product.inherit.tree.view</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_product_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                        <field name="product_brand_id"/>
                </xpath>
            </field>
        </record>
 </data>
</odoo>