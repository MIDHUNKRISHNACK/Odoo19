<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <data>

        <record id="sale_order_inherit_view" model="ir.ui.view">
            <field name="name">sale.order.inherit.view</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="brandwise_invoice" type="object" string="Brand Wise Invoice" class="oe_highlight"/>
                </xpath>
                 <xpath expr="//field[@name='payment_term_id']" position="after">
                   <field name="is_prime_partner"/>
                </xpath>
                 <xpath expr="//field[@name='order_line']/list/field[@name='tax_ids']" position="after">
                     <field name="product_brand_id"/>
                </xpath>


            </field>
        </record>
 </data>
</odoo>