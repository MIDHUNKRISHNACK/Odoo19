<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <data>
        <record id="res_partner_inherit_view" model="ir.ui.view">
            <field name="name">res.partner.inherit.view</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet//button[@name='action_view_partner_invoices']" position="after">
                     <div class="oe_button_box" name="button_box">
                          <button class="oe_stat_button" type="object"
                            name="action_open_wizard"
                            icon="fa-list">
                              <div class="o_stat_info">
                            <span class="o_stat_text">Draft</span>
                              </div>
                        </button>
                     </div>
                </xpath>
            </field>
        </record>
 </data>
</odoo>